# Defense in depth for future Apache deployment, NOT a publication authorization.
<IfModule mod_headers.c>
  <FilesMatch "^(index|password)\.html$">
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Cache-Control "no-store"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self' https://qgkwqzjapvjvzmvdfges.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'none'; frame-ancestors 'none'"
  </FilesMatch>
</IfModule>
